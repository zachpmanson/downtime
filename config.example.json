{
  "listen": ":8080",
  "history_size": 100,
  "monitors": [
    {
      "name": "Example Website",
      "type": "http",
      "url": "https://example.com",
      "interval": "30s",
      "timeout": "5s",
      "expect_status": [200]
    },
    {
      "name": "API Health",
      "type": "http",
      "url": "https://api.example.com/health",
      "interval": "30s",
      "timeout": "5s",
      "keyword": "ok"
    },
    {
      "name": "Postgres",
      "type": "tcp",
      "target": "db.internal:5432",
      "interval": "60s",
      "timeout": "5s"
    },
    {
      "name": "Old Game Server",
      "type": "tcp",
      "target": "games.internal:25565",
      "disabled": true
    }
  ],
  "xmpp": {
    "enabled": false,
    "jid": "monitor@example.com",
    "password": "env:XMPP_PASSWORD",
    "server": "",
    "recipients": ["zach@example.com"],
    "failure_threshold": 3
  }
}
